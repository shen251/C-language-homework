#include<stdio.h>
#include<string.h> 
int main()
{
  char enc[101],src[101],msg[101],jie[101];
  int len1,len2,p,q; 
  int map[26],use[26];
  scanf("%s%s%s",enc,src,msg);
  len1=strlen(enc);
  memset(map,-1,sizeof(map));
  memset(use,0,sizeof(use));
  for(int i=0;i<len1;i++){
  	p=src[i]-'A';
  	q=enc[i]-'A';
  	if(map[p]!=-1&&map[p]!=q){
  		printf("Failed");
  		return 0;
	  }
	if(use[q]==1&&q!=map[p]){
		printf("Failed");
  		return 0;
	}
	map[p]=q;
	use[q]=1;
    }
    for(int i=0;i<26;i++){
    	if(map[i]==-1){
    		printf("Failed");
    		return 0;
		} 
	}
	len2=strlen(msg);
	for(int i=0;i<len2;i++){
		int c=msg[i]-'A';
		for(int j=0;j<26;j++){
		if(c==map[j]){
			jie[i]=j;
		}	
		}
		char a=jie[i]+'A';
		printf("%c",a);
		}
 return 0; 
}
