#include<stdio.h>
#include<string.h>
int main(){
    char str[100];
    int len,sum=0;
    fgets(str,sizeof(str),stdin);
    len=strlen(str);
    for(int i=0;i<len;i++){
        if(str[i]<='9'&&str[i]>='0'){
            sum+=1;
        }
        else if(str[i]=='\n'){
            printf("%d",sum);
            return 0;
        }
        else{;}
    }
}
