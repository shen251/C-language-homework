#include <stdio.h>
#include <windows.h>

int main(void)
{
    float x, y;
    int flag = 1;   // 闪烁开关标记

    // 外层死循环实现闪烁效果
    while(1)
    {
        system("cls");  // 清屏

        // 根据flag切换文字颜色
        if(flag == 1)
        {
            // 红色文字
            SetConsoleTextAttribute(GetStdHandle(STD_OUTPUT_HANDLE), 14);
        }
        else
        {
            // 白色文字
            SetConsoleTextAttribute(GetStdHandle(STD_OUTPUT_HANDLE), 10);
        }

        // 双重循环遍历y纵向、x横向坐标
        for (y = 1.5f; y > -1.5f; y -= 0.1f)
        {
            for (x = -1.5f; x < 1.5f; x += 0.05f)
            {
                // 爱心数学方程条件判断
                float res = (x*x + y*y - 1)*(x*x + y*y - 1)*(x*x + y*y - 1) - x*x * y*y*y;
                if(res <= 0)
                {
                    printf("*");
                }
                else
                {
                    printf(" ");
                }
            }
            printf("\n");
        }

        flag = !flag;       // 翻转闪烁标记
        Sleep(100);         // 停留300毫秒
    }

    // 按Ctrl+C终止程序
    return 0;
}
