#include<stdio.h>
int main(){
	int n,m,a,sum[100]={0},sum1[100]={0};
	int  sumber[100][100];
	scanf("%d%d%d",&n,&m,&a);
	for(int i=1;i<=a;i++){
		for(int j=1;j<=n;j++){
			scanf("%d",&sumber[i][j]);			 
		}
	}
	for(int i=1;i<=n;i++){
		for(int j=1;j<=a;j++){
			sum[i]+=sumber[j][i];
		} 
	}
	for(int i=1;i<=n;i++){
		sum1[i]=sum[i]; 
	}
	for(int i=1;i<=n-1;i++){
		for(int j=1;j<=n-i-1;j++){
			if(sum[j]<sum[j+1]){
				int s;
				s=sum[j];sum[j]=sum[j+1];sum[j+1]=s; 
			}
		} 
	}
	for(int i=1;i<=m;i++){
		for(int j=1;j<=n;j++){
			if(sum[i]==sum1[j]){
				printf("%d ",j);
			}
		}
	}
	return 0; 
}
